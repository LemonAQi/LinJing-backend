APP_NAME=LinJing
APP_ENV=development
APP_PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=*
SWAGGER_ENABLED=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=linjing
DATABASE_PASSWORD=linjing
DATABASE_NAME=linjing
# 仅本地开发可设为 true；生产环境必须 false，改用 migration
DATABASE_SYNC=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
JWT_REFRESH_EXPIRES=7d
